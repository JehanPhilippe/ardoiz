rules_version = '2';

// ===============================================================
// Assumed Data Model — Ardoiz / CapDevoirs (K-12 French Homework & Family Cloud)
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// 1. Collection: parents
//    Document ID: {parentUid} (Firebase Auth UID of an adult parent)
//    Purpose: Private adult parent account & RGPD parental consent proof (PII — strictly owner-only).
//    Fields:
//      - uid: string (required, == {parentUid}, immutable) - Parent Firebase Auth UID
//      - displayName: string (required, 1..40 chars) - Parent display name / first name
//      - email: string (required, 3..120 chars, valid email format) - Parent email address
//      - consentAcceptedAt: timestamp | number (required, > 0 && <= 4102444800000, immutable) - RGPD parental consent timestamp
//      - consentVersion: string (required, 2..40 chars) - Accepted RGPD consent policy version
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000) - Last update timestamp or epoch ms
//
// 2. Collection: children
//    Document ID: {childId} (3..64 chars, ^[A-Za-z0-9_-]{3,64}$)
//    Purpose: Minor child profile & homework backup with 3 server-enforced roles:
//             - Parents (parentUids, 1..2): full control, co-parenting, invite/revoke, RGPD deletion
//             - Helpers / Proches (helperUids, 0..5 + helperLabels): read & pedagogical updates + self-unlink only
//             - Autonomous Student (studentUid, optional 1): read & pedagogical updates only
//    Fields (17 required — all keys explicit; nullable initialized to null; empty list/map initialized to [] / {}):
//      - childId: string (required, 3..64 chars, ^[A-Za-z0-9_-]{3,64}$, == {childId}, immutable) - Child document ID
//      - parentUids: list<string> (required, size 1..2, distinct UIDs 1..128 chars; [request.auth.uid] on create) - Linked parent UIDs
//      - createdBy: string (required, 1..128 chars, == request.auth.uid on create, immutable) - Initial creator parent UID
//      - helperUids: list<string> (required, size 0..5, distinct UIDs 1..128 chars; [] on create) - Linked helper/proche UIDs
//      - helperLabels: map<string, string> (required, size 0..5, keys subset of helperUids, values 1..30 chars; {} on create) - Helper display labels
//      - studentUid: string | null (required, null or 1..128 chars; null on create) - Linked autonomous student UID
//      - displayName: string (required, 1..40 chars) - Child first name / display name
//      - avatarColor: string (required, 4..20 chars) - Avatar color hex/token
//      - activeYearId: string (required, 9 chars, format YYYY-YYYY e.g. "2026-2027") - Active school year
//      - schoolUai: string | null (required, null or max 16 chars) - Linked official school UAI code
//      - classId: string | null (required, null or max 64 chars) - Linked class document ID
//      - surfaceMode: string (required, enum: 'paper' | 'day' | 'night') - UI theme mode
//      - dataJson: string (required, max 400000 chars and max 400000 bytes UTF-8) - Serialized schoolYears/notes/challenge JSON
//      - pendingInviteCode: string | null (required, null or ^[A-Z0-9]{6,12}$) - Active single-use invite code
//      - pendingInviteRole: string | null (required, null or 'parent' | 'helper' | 'student'; paired with pendingInviteCode) - Target role for invite
//      - pendingInviteExpiresAt: int | float | null (required, null or > 0 && <= now+49h; paired with pendingInviteCode) - Invite expiry epoch ms
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000) - Last update timestamp or epoch ms
//
// 3. Collection: parentInvites
//    Document ID: {code} (6..12 uppercase alphanumeric chars, e.g. 8-char single-use invite code)
//    Purpose: Single-use invite lookup for co-parent, helper, or autonomous student
//             (NO list allowed; exact get only; atomically deleted in writeBatch on join).
//    Fields (8 required):
//      - code: string (required, ^[A-Z0-9]{6,12}$, == {code}, immutable) - Invite code
//      - childId: string (required, 3..64 chars, ^[A-Za-z0-9_-]{3,64}$) - Target child document ID
//      - childName: string (required, 1..40 chars) - Child first name preview (no surname/email)
//      - levelId: string (required, enum: CP|CE1|CE2|CM1|CM2|6e|5e|4e|3e) - Child grade level preview
//      - role: string (required, enum: 'parent' | 'helper' | 'student') - Role granted upon invite acceptance
//      - label: string (required, 1..30 chars) - Human label for invitee (e.g. "Co-parent", "Tata Sophie", "Élève")
//      - createdBy: string (required, 1..128 chars, == request.auth.uid on create) - Inviting parent UID
//      - expiresAt: int | float (required, > request.time && <= request.time + 49h on create) - Expiration epoch ms (48h TTL)
//
// 4. Collection: users (legacy single-account / demo compatibility)
//    Document ID: {uid} (Firebase Auth UID)
//    Purpose: Private student/family backup & sync document (PII / private data — strictly owner-only).
//    Fields:
//      - uid: string (required, == {uid}, immutable) - Owner Firebase Auth UID
//      - displayName: string (required, 1..40 chars) - Student display name
//      - username: string (required, 2..32 chars) - Local account username
//      - activeYearId: string (required, 9 chars, format YYYY-YYYY e.g. "2026-2027") - Active school year
//      - schoolUai: string | null (required, null or max 16 chars) - Linked official school UAI code
//      - classId: string | null (required, null or max 64 chars) - Linked class document ID
//      - surfaceMode: string (required, enum: 'paper' | 'day' | 'night') - UI theme mode
//      - dataJson: string (required, max 400000 chars and max 400000 bytes UTF-8) - Serialized schoolYears JSON backup
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000) - Last update timestamp or epoch ms
//
// 5. Collection: schools
//    Document ID: {uai} (Official French Education Nationale UAI code, 6..12 alphanumeric chars, e.g. "0291590W")
//    Purpose: Official French school/college directory summary (no PII).
//    Fields:
//      - uai: string (required, 6..12 alphanumeric chars, == {uai}, immutable) - Official UAI code
//      - name: string (required, 2..120 chars) - Official establishment name
//      - city: string (required, 1..80 chars) - Municipality name
//      - postalCode: string (required, 2..10 chars) - Postal code
//      - type: string (required, 2..40 chars) - Establishment type (e.g. "Ecole", "Collège")
//      - createdBy: string (required, == request.auth.uid on create, immutable) - Creator UID
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000) - Last update timestamp or epoch ms
//
// 6. Collection: classes
//    Document ID: {classId} (e.g. "0291590W_2026-2027_CM2A48", 3..64 chars)
//    Purpose: Class room inside a school for a given school year.
//    Fields:
//      - classId: string (required, 3..64 chars, == {classId}, immutable) - Document ID
//      - uai: string (required, 6..12 alphanumeric chars, immutable) - Parent school UAI code
//      - schoolName: string (required, 2..120 chars, immutable) - School display name
//      - city: string (required, 1..80 chars, immutable) - School city
//      - className: string (required, 2..40 chars, mutable by createdBy) - Class label (e.g. "CM2-A")
//      - levelId: string (required, enum: CP|CE1|CE2|CM1|CM2|6e|5e|4e|3e, immutable) - French grade level
//      - yearId: string (required, 9 chars, format YYYY-YYYY, immutable) - School year ID
//      - inviteCode: string (required, 4..12 uppercase alphanumeric chars, immutable) - Join invite code
//      - weeklyGoalPoints: int (required, 100..50000, mutable by createdBy) - Weekly class challenge goal
//      - createdBy: string (required, == request.auth.uid on create, immutable) - Creator UID
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000, mutable by createdBy) - Last update timestamp or epoch ms
//
// 7. Subcollection: classes/{classId}/members
//    Document ID: {memberId} (either legacy Firebase Auth UID == request.auth.uid, OR a childId accessible via children/{memberId})
//    Purpose: RGPD-safe student challenge scorecard (pseudo only, no full name or email).
//    Fields:
//      - uid: string (required, == request.auth.uid on create/update) - Syncing authenticated Firebase Auth UID
//      - classId: string (required, 3..64 chars, == {classId}, immutable) - Parent class ID
//      - uai: string (required, 6..12 alphanumeric chars) - School UAI code
//      - pseudo: string (required, 2..24 chars) - RGPD-safe student pseudonym
//      - levelId: string (required, enum: CP|CE1|CE2|CM1|CM2|6e|5e|4e|3e) - French grade level
//      - avatarColor: string (required, 4..20 chars) - Avatar color hex/token
//      - points: int (required, 0..1000000) - Total challenge points
//      - exercisesCount: int (required, 0..50000) - Completed exercises count
//      - quizzesCount: int (required, 0..50000) - Completed quizzes count
//      - homeworksDone: int (required, 0..50000) - Completed homeworks count
//      - attendusDone: int (required, 0..5000) - Mastered official "attendus" count
//      - avgOn20: number | null (required, null or 0..20) - Overall average score out of 20
//      - streak: int (required, 0..10000) - Current infinite practice streak
//      - updatedAt: timestamp | number (required, > 0 && <= 4102444800000) - Last sync timestamp or epoch ms
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request comes from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the path-scoped resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify uid field matches authenticated user on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == request.auth.uid;
    }

    // Verify uid field has not been altered on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == resource.data.uid;
    }

    // Ensure all required keys exist in the post-write document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Ensure no extraneous/undefined keys exist in the post-write document
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Ensure immutable fields are not modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate a non-null string within [minLen, maxLen] characters
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate a nullable string (null or string with length <= maxLen)
    function isValidNullableString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // Validate an integer within [minVal, maxVal]
    function isValidIntRange(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    // Validate a Firestore timestamp or a positive epoch-ms number (up to year 2100)
    function isValidUpdatedAt(val) {
      return val is timestamp ||
             ((val is int || val is float) && val > 0 && val <= 4102444800000);
    }

    // Validate a positive epoch-ms number (up to year 2100)
    function isValidEpochMs(val) {
      return (val is int || val is float) && val > 0 && val <= 4102444800000;
    }

    // Validate email format (supports internationalized local parts while rejecting spaces)
    function isValidEmail(val) {
      return isValidString(val, 3, 120) &&
             val.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Validate official French school year ID (e.g. "2026-2027")
    function isValidYearId(val) {
      return val is string &&
             val.size() == 9 &&
             val.matches('^\\d{4}-\\d{4}$');
    }

    // Validate official French K-12 primary/collège level ID
    function isValidLevelId(val) {
      return val is string &&
             val in ['CP', 'CE1', 'CE2', 'CM1', 'CM2', '6e', '5e', '4e', '3e'];
    }

    // Validate official Education Nationale UAI identifier (6..12 alphanumeric chars)
    function isValidUai(val) {
      return val is string &&
             val.size() >= 6 &&
             val.size() <= 12 &&
             val.matches('^[A-Za-z0-9]{6,12}$');
    }

    // Validate uppercase alphanumeric class invite code (4..12 chars)
    function isValidInviteCode(val) {
      return val is string &&
             val.size() >= 4 &&
             val.size() <= 12 &&
             val.matches('^[A-Z0-9]{4,12}$');
    }

    // Validate uppercase alphanumeric family/student invite code (6..12 chars)
    function isValidParentInviteCode(val) {
      return val is string &&
             val.size() >= 6 &&
             val.size() <= 12 &&
             val.matches('^[A-Z0-9]{6,12}$');
    }

    // Validate supported invite roles for children/{childId} and parentInvites/{code}
    function isValidInviteRole(val) {
      return val is string && val in ['parent', 'helper', 'student'];
    }

    // Validate child document ID format (3..64 safe ID characters)
    function isValidChildId(val) {
      return val is string &&
             val.size() >= 3 &&
             val.size() <= 64 &&
             val.matches('^[A-Za-z0-9_-]{3,64}$');
    }

    // Validate supported UI surface modes
    function isValidSurfaceMode(val) {
      return val is string && val in ['paper', 'day', 'night'];
    }

    // Validate nullable French grade average out of 20 (rejects NaN/Infinity/out-of-range)
    function isValidAvgOn20(val) {
      return val == null ||
             ((val is int || val is float) && val >= 0 && val <= 20);
    }

    // Deep inspection of child parentUids list (size 1 or 2, valid non-empty distinct UID strings)
    function isValidParentUidsList(uids) {
      return uids is list &&
             uids.size() >= 1 &&
             uids.size() <= 2 &&
             isValidString(uids[0], 1, 128) &&
             (uids.size() == 1 || (isValidString(uids[1], 1, 128) && uids[1] != uids[0]));
    }

    // Deep inspection of child helperUids list (size 0..5, valid non-empty distinct UID strings)
    function isValidHelperUidsList(uids) {
      return uids is list &&
             uids.size() <= 5 &&
             uids.toSet().size() == uids.size() &&
             (uids.size() < 1 || isValidString(uids[0], 1, 128)) &&
             (uids.size() < 2 || isValidString(uids[1], 1, 128)) &&
             (uids.size() < 3 || isValidString(uids[2], 1, 128)) &&
             (uids.size() < 4 || isValidString(uids[3], 1, 128)) &&
             (uids.size() < 5 || isValidString(uids[4], 1, 128));
    }

    // Deep inspection of helperLabels map (size 0..5, keys subset of helperUids, every value 1..30 chars)
    function isValidHelperLabelsMap(labels, uids) {
      return labels is map &&
             labels.size() <= 5 &&
             labels.keys().hasOnly(uids) &&
             (uids.size() < 1 || !(uids[0] in labels) || isValidString(labels[uids[0]], 1, 30)) &&
             (uids.size() < 2 || !(uids[1] in labels) || isValidString(labels[uids[1]], 1, 30)) &&
             (uids.size() < 3 || !(uids[2] in labels) || isValidString(labels[uids[2]], 1, 30)) &&
             (uids.size() < 4 || !(uids[3] in labels) || isValidString(labels[uids[3]], 1, 30)) &&
             (uids.size() < 5 || !(uids[4] in labels) || isValidString(labels[uids[4]], 1, 30));
    }

    // Validate nullable autonomous student UID (null or valid 1..128 char UID string)
    function isValidStudentUid(val) {
      return val == null || isValidString(val, 1, 128);
    }

    // Validate paired pendingInviteCode, pendingInviteRole & pendingInviteExpiresAt fields on a child doc
    function isValidPendingInviteFields(data) {
      return (data.pendingInviteCode == null &&
              data.pendingInviteRole == null &&
              data.pendingInviteExpiresAt == null) ||
             (isValidParentInviteCode(data.pendingInviteCode) &&
              isValidInviteRole(data.pendingInviteRole) &&
              isValidEpochMs(data.pendingInviteExpiresAt) &&
              data.pendingInviteExpiresAt <= request.time.toMillis() + 176400000 &&
              (
                (data.pendingInviteRole == 'parent' && data.parentUids.size() == 1) ||
                (data.pendingInviteRole == 'helper' && data.helperUids.size() < 5) ||
                (data.pendingInviteRole == 'student' && data.studentUid == null)
              ));
    }

    // Check whether the authenticated user is a linked parent of children/{childId}
    function isParentOfChild(childId) {
      let childPath = /databases/$(database)/documents/children/$(childId);
      return isAuthenticated() &&
             exists(childPath) &&
             request.auth.uid in get(childPath).data.parentUids;
    }

    // Check whether the authenticated user has any authorized role on children/{childId}
    // (linked parent, authorized helper/proche, or autonomous student)
    function isChildAccessMember(childId) {
      let childPath = /databases/$(database)/documents/children/$(childId);
      return isAuthenticated() &&
             exists(childPath) &&
             (request.auth.uid in get(childPath).data.parentUids ||
              ('helperUids' in get(childPath).data &&
               request.auth.uid in get(childPath).data.helperUids) ||
              ('studentUid' in get(childPath).data &&
               get(childPath).data.studentUid == request.auth.uid));
    }

    // Check whether the authenticated user is transitioning into the invited role on children/{childId}
    // during an atomic writeBatch that consumes parentInvites/{code}
    function isJoiningInviteTarget(childId, role) {
      let childPath = /databases/$(database)/documents/children/$(childId);
      return isAuthenticated() &&
             exists(childPath) &&
             existsAfter(childPath) &&
             (
               (role == 'parent' &&
                !(request.auth.uid in get(childPath).data.parentUids) &&
                request.auth.uid in getAfter(childPath).data.parentUids) ||
               (role == 'helper' &&
                !(request.auth.uid in get(childPath).data.helperUids) &&
                request.auth.uid in getAfter(childPath).data.helperUids) ||
               (role == 'student' &&
                get(childPath).data.studentUid == null &&
                getAfter(childPath).data.studentUid == request.auth.uid)
             );
    }

    // Check whether the authenticated parent may create an invite for children/{childId} for the given role
    function canCreateInviteForChild(childId, role) {
      let childPath = /databases/$(database)/documents/children/$(childId);
      return isAuthenticated() &&
             exists(childPath) &&
             request.auth.uid in get(childPath).data.parentUids &&
             (
               (role == 'parent' && get(childPath).data.parentUids.size() == 1) ||
               (role == 'helper' &&
                (!('helperUids' in get(childPath).data) ||
                 get(childPath).data.helperUids.size() < 5)) ||
               (role == 'student' &&
                (!('studentUid' in get(childPath).data) ||
                 get(childPath).data.studentUid == null))
             );
    }

    // Path A (Parent): edit child data / create or revoke invite / remove helper / clear studentUid,
    // OR self-unlink when 2 parents exist (leaving 1 remaining parent).
    // Prevents a parent from forcibly injecting arbitrary UIDs into helperUids or studentUid.
    function isValidParentChildUpdate() {
      return request.auth.uid in resource.data.parentUids &&
             (
               (request.resource.data.parentUids == resource.data.parentUids &&
                ((!('helperUids' in resource.data) && request.resource.data.helperUids == []) ||
                 ('helperUids' in resource.data && resource.data.helperUids.hasAll(request.resource.data.helperUids))) &&
                ((!('studentUid' in resource.data) && request.resource.data.studentUid == null) ||
                 ('studentUid' in resource.data &&
                  (request.resource.data.studentUid == resource.data.studentUid ||
                   request.resource.data.studentUid == null)))) ||
               (resource.data.parentUids.size() == 2 &&
                request.resource.data.parentUids.size() == 1 &&
                !(request.auth.uid in request.resource.data.parentUids) &&
                request.resource.data.parentUids[0] in resource.data.parentUids &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'parentUids',
                  'updatedAt'
                ]))
             );
    }

    // Path B1 (Helper or Autonomous Student): pedagogical updates ONLY
    function isValidPedagogicalMemberUpdate() {
      return (request.auth.uid in resource.data.helperUids ||
              resource.data.studentUid == request.auth.uid) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'activeYearId',
               'schoolUai',
               'classId',
               'surfaceMode',
               'dataJson',
               'updatedAt'
             ]);
    }

    // Path B2 (Helper): self-unlink ONLY (removes solely request.auth.uid from helperUids & helperLabels)
    function isValidHelperSelfUnlink() {
      return request.auth.uid in resource.data.helperUids &&
             !(request.auth.uid in request.resource.data.helperUids) &&
             request.resource.data.helperUids.size() == resource.data.helperUids.size() - 1 &&
             resource.data.helperUids.hasAll(request.resource.data.helperUids) &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).addedKeys().size() == 0 &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).changedKeys().size() == 0 &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).removedKeys().hasOnly([request.auth.uid]) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'helperUids',
               'helperLabels',
               'updatedAt'
             ]);
    }

    // Verify atomic consumption of parentInvites/{inviteCode} (called only after inviteCode is validated)
    function isValidInviteConsumption(childId, inviteCode, inviteRole) {
      let invitePath = /databases/$(database)/documents/parentInvites/$(inviteCode);
      return exists(invitePath) &&
             !existsAfter(invitePath) &&
             get(invitePath).data.childId == childId &&
             get(invitePath).data.role == inviteRole &&
             get(invitePath).data.expiresAt > request.time.toMillis();
    }

    // Common preconditions for Path C atomic invite join via writeBatch
    // Requiring !existsAfter(parentInvites/code) proves the caller knows the exact secret invite code
    // and consumes it atomically so it cannot be replayed or bypassed by guessing childId alone.
    function isValidInviteJoinBase(childId) {
      return isAuthenticated() &&
             isValidParentInviteCode(resource.data.pendingInviteCode) &&
             isValidInviteRole(resource.data.pendingInviteRole) &&
             isValidEpochMs(resource.data.pendingInviteExpiresAt) &&
             resource.data.pendingInviteExpiresAt > request.time.toMillis() &&
             isValidInviteConsumption(
               childId,
               resource.data.pendingInviteCode,
               resource.data.pendingInviteRole
             ) &&
             request.resource.data.pendingInviteCode == null &&
             request.resource.data.pendingInviteRole == null &&
             request.resource.data.pendingInviteExpiresAt == null;
    }

    // Path C (Role = 'parent'): 2nd co-parent joining atomically via writeBatch
    function isValidParentInviteJoin(childId) {
      return resource.data.pendingInviteRole == 'parent' &&
             isValidInviteJoinBase(childId) &&
             resource.data.parentUids.size() == 1 &&
             !(request.auth.uid in resource.data.parentUids) &&
             request.resource.data.parentUids.size() == 2 &&
             request.resource.data.parentUids[0] == resource.data.parentUids[0] &&
             request.resource.data.parentUids[1] == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'parentUids',
               'pendingInviteCode',
               'pendingInviteRole',
               'pendingInviteExpiresAt',
               'updatedAt'
             ]);
    }

    // Path C (Role = 'helper'): helper/proche joining atomically via writeBatch (max 5 helpers)
    function isValidHelperInviteJoin(childId) {
      return resource.data.pendingInviteRole == 'helper' &&
             isValidInviteJoinBase(childId) &&
             resource.data.helperUids.size() < 5 &&
             !(request.auth.uid in resource.data.parentUids) &&
             !(request.auth.uid in resource.data.helperUids) &&
             request.resource.data.helperUids.size() == resource.data.helperUids.size() + 1 &&
             request.resource.data.helperUids.hasAll(resource.data.helperUids) &&
             request.auth.uid in request.resource.data.helperUids &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).addedKeys().hasOnly([request.auth.uid]) &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).removedKeys().size() == 0 &&
             request.resource.data.helperLabels.diff(resource.data.helperLabels).changedKeys().size() == 0 &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'helperUids',
               'helperLabels',
               'pendingInviteCode',
               'pendingInviteRole',
               'pendingInviteExpiresAt',
               'updatedAt'
             ]);
    }

    // Path C (Role = 'student'): autonomous middle-schooler joining atomically via writeBatch (max 1 student)
    function isValidStudentInviteJoin(childId) {
      return resource.data.pendingInviteRole == 'student' &&
             isValidInviteJoinBase(childId) &&
             resource.data.studentUid == null &&
             !(request.auth.uid in resource.data.parentUids) &&
             request.resource.data.studentUid == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'studentUid',
               'pendingInviteCode',
               'pendingInviteRole',
               'pendingInviteExpiresAt',
               'updatedAt'
             ]);
    }

    // Check if the authenticated user can manage classes/{classId}/members/{memberId}
    // Supports legacy single-user (memberId == auth.uid) AND any role member of children/{memberId}
    function canManageClassMember(memberId) {
      return isOwner(memberId) || isChildAccessMember(memberId);
    }

    // ===============================================================
    // Domain Validators (Called on BOTH create and update)
    // ===============================================================

    function isValidParentDoc(data, parentUid) {
      let allowed = [
        'uid',
        'displayName',
        'email',
        'consentAcceptedAt',
        'consentVersion',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             data.uid is string && data.uid == parentUid &&
             isValidString(data.displayName, 1, 40) &&
             isValidEmail(data.email) &&
             isValidUpdatedAt(data.consentAcceptedAt) &&
             isValidString(data.consentVersion, 2, 40) &&
             isValidUpdatedAt(data.updatedAt);
    }

    function isValidChildDoc(data, childId) {
      let allowed = [
        'childId',
        'parentUids',
        'createdBy',
        'helperUids',
        'helperLabels',
        'studentUid',
        'displayName',
        'avatarColor',
        'activeYearId',
        'schoolUai',
        'classId',
        'surfaceMode',
        'dataJson',
        'pendingInviteCode',
        'pendingInviteRole',
        'pendingInviteExpiresAt',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             isValidChildId(data.childId) && data.childId == childId &&
             isValidParentUidsList(data.parentUids) &&
             isValidString(data.createdBy, 1, 128) &&
             isValidHelperUidsList(data.helperUids) &&
             isValidHelperLabelsMap(data.helperLabels, data.helperUids) &&
             isValidStudentUid(data.studentUid) &&
             isValidString(data.displayName, 1, 40) &&
             isValidString(data.avatarColor, 4, 20) &&
             isValidYearId(data.activeYearId) &&
             isValidNullableString(data.schoolUai, 16) &&
             isValidNullableString(data.classId, 64) &&
             isValidSurfaceMode(data.surfaceMode) &&
             data.dataJson is string &&
             data.dataJson.size() <= 400000 &&
             data.dataJson.toUtf8().size() <= 400000 &&
             isValidPendingInviteFields(data) &&
             isValidUpdatedAt(data.updatedAt);
    }

    function isValidParentInviteDoc(data, code) {
      let allowed = [
        'code',
        'childId',
        'childName',
        'levelId',
        'role',
        'label',
        'createdBy',
        'expiresAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             isValidParentInviteCode(data.code) && data.code == code &&
             isValidChildId(data.childId) &&
             isValidString(data.childName, 1, 40) &&
             isValidLevelId(data.levelId) &&
             isValidInviteRole(data.role) &&
             isValidString(data.label, 1, 30) &&
             isValidString(data.createdBy, 1, 128) &&
             isValidEpochMs(data.expiresAt);
    }

    function isValidUserDoc(data, uid) {
      let allowed = [
        'uid',
        'displayName',
        'username',
        'activeYearId',
        'schoolUai',
        'classId',
        'surfaceMode',
        'dataJson',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             data.uid is string && data.uid == uid &&
             isValidString(data.displayName, 1, 40) &&
             isValidString(data.username, 2, 32) &&
             isValidYearId(data.activeYearId) &&
             isValidNullableString(data.schoolUai, 16) &&
             isValidNullableString(data.classId, 64) &&
             isValidSurfaceMode(data.surfaceMode) &&
             data.dataJson is string &&
             data.dataJson.size() <= 400000 &&
             data.dataJson.toUtf8().size() <= 400000 &&
             isValidUpdatedAt(data.updatedAt);
    }

    function isValidSchoolDoc(data, uai) {
      let allowed = [
        'uai',
        'name',
        'city',
        'postalCode',
        'type',
        'createdBy',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             isValidUai(data.uai) && data.uai == uai &&
             isValidString(data.name, 2, 120) &&
             isValidString(data.city, 1, 80) &&
             isValidString(data.postalCode, 2, 10) &&
             isValidString(data.type, 2, 40) &&
             isValidString(data.createdBy, 1, 128) &&
             isValidUpdatedAt(data.updatedAt);
    }

    function isValidClassDoc(data, classId) {
      let allowed = [
        'classId',
        'uai',
        'schoolName',
        'city',
        'className',
        'levelId',
        'yearId',
        'inviteCode',
        'weeklyGoalPoints',
        'createdBy',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             isValidString(data.classId, 3, 64) && data.classId == classId &&
             isValidUai(data.uai) &&
             isValidString(data.schoolName, 2, 120) &&
             isValidString(data.city, 1, 80) &&
             isValidString(data.className, 2, 40) &&
             isValidLevelId(data.levelId) &&
             isValidYearId(data.yearId) &&
             isValidInviteCode(data.inviteCode) &&
             isValidIntRange(data.weeklyGoalPoints, 100, 50000) &&
             isValidString(data.createdBy, 1, 128) &&
             isValidUpdatedAt(data.updatedAt);
    }

    function isValidMemberDoc(data, classId) {
      let allowed = [
        'uid',
        'classId',
        'uai',
        'pseudo',
        'levelId',
        'avatarColor',
        'points',
        'exercisesCount',
        'quizzesCount',
        'homeworksDone',
        'attendusDone',
        'avgOn20',
        'streak',
        'updatedAt'
      ];
      return hasOnlyAllowedFields(allowed) &&
             hasRequiredFields(allowed) &&
             data.uid is string && data.uid == request.auth.uid &&
             isValidString(data.classId, 3, 64) && data.classId == classId &&
             isValidUai(data.uai) &&
             isValidString(data.pseudo, 2, 24) &&
             isValidLevelId(data.levelId) &&
             isValidString(data.avatarColor, 4, 20) &&
             isValidIntRange(data.points, 0, 1000000) &&
             isValidIntRange(data.exercisesCount, 0, 50000) &&
             isValidIntRange(data.quizzesCount, 0, 50000) &&
             isValidIntRange(data.homeworksDone, 0, 50000) &&
             isValidIntRange(data.attendusDone, 0, 5000) &&
             isValidAvgOn20(data.avgOn20) &&
             isValidIntRange(data.streak, 0, 10000) &&
             isValidUpdatedAt(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Private adult parent profile & RGPD consent record — STRICTLY owner-only
    match /parents/{parentUid} {
      allow read: if isOwner(parentUid);
      allow create: if isOwner(parentUid) &&
                       uidUnchanged() &&
                       isValidParentDoc(request.resource.data, parentUid);
      allow update: if isOwner(parentUid) &&
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['uid', 'consentAcceptedAt']) &&
                       isValidParentDoc(request.resource.data, parentUid);
      allow delete: if isOwner(parentUid);
    }

    // 2. Minor child profile with 3 server-enforced roles:
    //    - Parents (parentUids, 1..2): full control + RGPD deletion
    //    - Helpers / Proches (helperUids, 0..5): pedagogical updates + self-unlink
    //    - Autonomous Student (studentUid, 0..1): pedagogical updates only
    //    Supports queries: array-contains on parentUids, array-contains on helperUids, == on studentUid.
    match /children/{childId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid in resource.data.parentUids ||
                      request.auth.uid in resource.data.helperUids ||
                      resource.data.studentUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.parentUids == [request.auth.uid] &&
                       request.resource.data.helperUids == [] &&
                       request.resource.data.helperLabels is map &&
                       request.resource.data.helperLabels.size() == 0 &&
                       request.resource.data.studentUid == null &&
                       isValidChildDoc(request.resource.data, childId);
      allow update: if isAuthenticated() &&
                       areImmutableFieldsUnchanged(['childId', 'createdBy']) &&
                       isValidChildDoc(request.resource.data, childId) &&
                       (
                         // Path A: Linked parent managing child, revoking helpers/student, invites, or self-unlinking
                         isValidParentChildUpdate() ||
                         // Path B1: Authorized helper or autonomous student updating pedagogical fields ONLY
                         isValidPedagogicalMemberUpdate() ||
                         // Path B2: Authorized helper unlinking ONLY themselves from helperUids & helperLabels
                         isValidHelperSelfUnlink() ||
                         // Path C: Atomic join via writeBatch consuming parentInvites/{code}
                         isValidParentInviteJoin(childId) ||
                         isValidHelperInviteJoin(childId) ||
                         isValidStudentInviteJoin(childId)
                       );
      allow delete: if isAuthenticated() &&
                       request.auth.uid in resource.data.parentUids &&
                       (resource.data.parentUids.size() == 1 ||
                        resource.data.createdBy == request.auth.uid);
    }

    // 3. Single-use invite lookup for parent / helper / student roles (NO list allowed; exact code get only)
    match /parentInvites/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       isValidParentInviteDoc(request.resource.data, code) &&
                       canCreateInviteForChild(request.resource.data.childId, request.resource.data.role) &&
                       request.resource.data.expiresAt > request.time.toMillis() &&
                       request.resource.data.expiresAt <= request.time.toMillis() + 176400000;
      allow update: if false;
      allow delete: if isAuthenticated() &&
                       (resource.data.createdBy == request.auth.uid ||
                        isParentOfChild(resource.data.childId) ||
                        isJoiningInviteTarget(resource.data.childId, resource.data.role));
    }

    // 4. Legacy single-account / demo private backup & sync document — STRICTLY owner-only
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
                       uidUnchanged() &&
                       isValidUserDoc(request.resource.data, uid);
      allow update: if isOwner(uid) &&
                       uidNotModified() &&
                       areImmutableFieldsUnchanged(['uid']) &&
                       isValidUserDoc(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }

    // 5. Official French school/collège summary (no PII)
    match /schools/{uai} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isValidSchoolDoc(request.resource.data, uai) &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.createdBy == request.auth.uid &&
                       areImmutableFieldsUnchanged(['uai', 'createdBy']) &&
                       isValidSchoolDoc(request.resource.data, uai);
      allow delete: if false;
    }

    // 6. Class room inside a school for a given school year
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isValidClassDoc(request.resource.data, classId) &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.createdBy == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'className',
                         'weeklyGoalPoints',
                         'updatedAt'
                       ]) &&
                       areImmutableFieldsUnchanged([
                         'classId',
                         'uai',
                         'schoolName',
                         'city',
                         'levelId',
                         'yearId',
                         'inviteCode',
                         'createdBy'
                       ]) &&
                       isValidClassDoc(request.resource.data, classId);
      allow delete: if isAuthenticated() &&
                       resource.data.createdBy == request.auth.uid;

      // 7. RGPD-safe student challenge scorecard inside a class
      // memberId is EITHER request.auth.uid (legacy) OR a childId accessible via children/{memberId}
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if canManageClassMember(memberId) &&
                         uidUnchanged() &&
                         exists(/databases/$(database)/documents/classes/$(classId)) &&
                         isValidMemberDoc(request.resource.data, classId);
        allow update: if canManageClassMember(memberId) &&
                         areImmutableFieldsUnchanged(['classId']) &&
                         (!isOwner(memberId) || uidNotModified()) &&
                         isValidMemberDoc(request.resource.data, classId);
        allow delete: if canManageClassMember(memberId) ||
                         (isAuthenticated() &&
                          !exists(/databases/$(database)/documents/children/$(memberId)) &&
                          resource.data.uid == request.auth.uid);
      }
    }

    // Default deny for all other collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
